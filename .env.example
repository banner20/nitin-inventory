# Copy to .env.local and fill in. Only VITE_* vars reach the browser —
# never put a service-role key or the Groq key in this file.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Server-side only. Set these as Supabase function secrets, not here:
#   supabase secrets set GROQ_API_KEY=...
# GROQ_API_KEY=
